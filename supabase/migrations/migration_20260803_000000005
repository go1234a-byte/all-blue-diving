-- ALL BLUE 다이빙 플랫폼 — 보안 강화 2단계: profiles(회원정보) 조회(select) 잠금
--
-- 문제: profiles 테이블의 select 정책이 지금 `using (true)` — 로그인 여부와 무관하게
--   누구나 Supabase REST API를 직접 호출하면 전체 회원의 전화번호, 생년월일, 비상연락처
--   이름/번호, C-Card 자격증 번호, 보험 정보까지 전부 그대로 조회할 수 있는 상태입니다.
--   화면(프론트엔드)에서는 본인/담당강사/관리자만 보이게 가려놨지만, 그건 "화면에서만"
--   막은 것이고 실제 데이터는 이미 브라우저 메모리와 API 응답에 전부 내려오고 있습니다.
--
-- 확인된 정상 기능(유지해야 함): 같은 투어를 예약한 다이버끼리는 채팅방에서 서로의
--   나이(생년월일)·C-Card 등급·로그수를 보고 있습니다(그룹 다이빙 안전 목적). 이 기능은
--   그대로 유지하기로 했습니다. 전화번호·긴급연락처·C-Card 번호·보험정보는 지금도
--   본인/담당강사/관리자만 화면에 보여주고 있어서, 이 정보들만 실제로도 잠급니다.
--
-- 적용 방법: Supabase 대시보드 → SQL Editor에 아래 전체를 붙여넣고 실행(Run)
--   https://supabase.com/dashboard/project/fffslvvligcpadkcyzvo/sql/new
--
-- *** 이 SQL과 함께 반드시 코드 패치(fix_profiles_directory_frontend.patch)도 같은 배포에
-- 포함해야 합니다. 코드 없이 SQL만 적용하면 화면에서 모든 회원정보(본인 것 포함)가
-- 갑자기 안 보이게 됩니다(지금 프론트엔드가 profiles 테이블을 직접 select 하기 때문). ***
--
-- 문제가 생기면 fix_profiles_select_lockdown_rollback.sql로 즉시 되돌릴 수 있습니다.

-- ════════════════════════════════════════════════════════════════
-- 1) 헬퍼 함수 2개 추가
-- ════════════════════════════════════════════════════════════════

-- 이 프로필(p_profile_id)에 대해 "담당강사/본인/관리자"로서 민감정보(전화번호,
-- 긴급연락처, C-Card 번호, 보험정보, 성별, 코골이/흡연 여부)까지 볼 수 있는 사람인지.
create or replace function public.is_profile_staff_for(p_profile_id text)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select
    auth.uid()::text = p_profile_id
    or public.is_admin()
    or exists (
      select 1 from public.bookings b
      where b.diver_id = p_profile_id and public.owns_tour(b.tour_id)
    );
$$;
grant execute on function public.is_profile_staff_for(text) to anon, authenticated;

-- 이 프로필(p_profile_id)에 대해 "같은 투어 동승자"로서 안전 정보(생년월일/나이,
-- C-Card 등급, 로그수)를 볼 수 있는 사람인지. staff(본인/담당강사/관리자)를 포함한다.
create or replace function public.is_tour_companion_of(p_profile_id text)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select
    public.is_profile_staff_for(p_profile_id)
    or exists (
      select 1 from public.bookings mine
      join public.bookings theirs
        on theirs.tour_id = mine.tour_id and theirs.diver_id = p_profile_id
      where mine.diver_id = auth.uid()::text
    );
$$;
grant execute on function public.is_tour_companion_of(text) to anon, authenticated;

-- ════════════════════════════════════════════════════════════════
-- 2) profiles_directory 뷰 — 컬럼별로 조건부 마스킹된 회원정보
--    (기존 public_profiles 뷰는 그대로 두고, 이건 프론트엔드 부트스트랩 조회 전용으로 추가)
-- ════════════════════════════════════════════════════════════════
create or replace view public.profiles_directory as
select
  p.id,
  p.role,
  p.name,
  p.status,
  p.created_at,
  case when public.is_tour_companion_of(p.id) then p.birth_date else null end as birth_date,
  case when public.is_tour_companion_of(p.id) then p.c_card_agency else null end as c_card_agency,
  case when public.is_tour_companion_of(p.id) then p.log_count else null end as log_count,
  case when public.is_profile_staff_for(p.id) then p.phone else null end as phone,
  case when public.is_profile_staff_for(p.id) then p.gender else null end as gender,
  case when public.is_profile_staff_for(p.id) then p.snoring else null end as snoring,
  case when public.is_profile_staff_for(p.id) then p.smoking else null end as smoking,
  case when public.is_profile_staff_for(p.id) then p.c_card_number else null end as c_card_number,
  case when public.is_profile_staff_for(p.id) then p.emergency_contact_name else null end as emergency_contact_name,
  case when public.is_profile_staff_for(p.id) then p.emergency_contact_phone else null end as emergency_contact_phone,
  case when public.is_profile_staff_for(p.id) then p.insurance_info else null end as insurance_info
from public.profiles p
where p.deleted_at is null;

grant select on public.profiles_directory to anon, authenticated;

-- ════════════════════════════════════════════════════════════════
-- 3) profiles 테이블 자체의 select 정책 잠금 (직접 REST 호출 차단)
--    profiles_directory 뷰는 뷰 소유자 권한으로 이 밑의 정책과 무관하게 계속 동작합니다.
-- ════════════════════════════════════════════════════════════════
drop policy if exists "profiles_select_own_or_public" on public.profiles;
drop policy if exists "profiles_select_own" on public.profiles;
create policy "profiles_select_own_or_admin" on public.profiles
  for select using (auth.uid() = id or public.is_admin());

-- ════════════════════════════════════════════════════════════════
-- 완료. 아래로 정상 반영됐는지 확인할 수 있습니다.
-- ════════════════════════════════════════════════════════════════
select schemaname, tablename, policyname, cmd
from pg_policies
where schemaname = 'public' and tablename = 'profiles'
order by cmd;

select * from public.profiles_directory limit 3;
