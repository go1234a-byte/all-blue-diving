{
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/search",
      "destination": "/api/page?p=search"
    },
    {
      "source": "/guide",
      "destination": "/api/page?p=guide"
    },
    {
      "source": "/tour/:id",
      "destination": "/api/og/tour/:id"
    },
    {
      "source": "/instructor/:id/profile",
      "destination": "/api/og/instructor/:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/dive",
      "destination": "/dive/index.html"
    },
    {
      "source": "/dive/:id",
      "destination": "/dive/:id/index.html"
    },
    {
      "source": "/((?:green-island-dive-shop|green-island-part-time-swap|kinmen-part-time-swap|lanyu-diving-inn|lanyu-island-part-time-swap|mazu-part-time-swap|penghu-part-time-swap|xiaoliuqiu-part-time-swap|privacy-policy|sample-page)/?)",
      "destination": "/api/gone"
    },
    {
      "source": "/((?:wp-content|wp-includes|wp-admin|wp-json|category|tag|author|feed|comments)(?:/.*)?)",
      "destination": "/api/gone"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/{index,spa}.html"
    },
    "api/og/tour/[id].js": {
      "includeFiles": "dist/{index,spa}.html"
    },
    "api/og/instructor/[id].js": {
      "includeFiles": "dist/{index,spa}.html"
    },
    "api/sitemap.js": {
      "includeFiles": "dist/dive/manifest.json"
    }
  }
}
