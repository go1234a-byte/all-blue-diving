{
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/tour/:id",
      "destination": "/api/og/tour/:id"
    },
    {
      "source": "/instructor/:id/profile",
      "destination": "/api/og/instructor/:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/dive",
      "destination": "/dive/index.html"
    },
    {
      "source": "/dive/:id",
      "destination": "/dive/:id/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/og/tour/[id].js": {
      "includeFiles": "dist/index.html"
    },
    "api/og/instructor/[id].js": {
      "includeFiles": "dist/index.html"
    },
    "api/sitemap.js": {
      "includeFiles": "dist/dive/manifest.json"
    }
  }
}
