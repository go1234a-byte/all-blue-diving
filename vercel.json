{
  "rewrites": [
    { "source": "/", "destination": "/api/page?p=home" },
    { "source": "/search", "destination": "/api/page?p=search" },
    { "source": "/guide", "destination": "/api/page?p=guide" },
    { "source": "/tour/:id", "destination": "/api/og/tour/:id" },
    { "source": "/instructor/:id/profile", "destination": "/api/og/instructor/:id" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<sub>.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/og/tour/[id].js": {
      "includeFiles": "dist/index.html"
    },
    "api/og/instructor/[id].js": {
      "includeFiles": "dist/index.html"
    }
  }
}
